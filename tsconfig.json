{
  "compilerOptions": {
    /* 语言与模块：纯 ESM，Node 22+ */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    /* 严格性：本项目的不可变数据契约依赖这些开关 */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    /* 输出 */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": false,
    "importHelpers": false,

    /* 内核不得依赖 UI 框架：装饰器仍禁用。
       JSX 供 src/clients/tui 使用；`react-jsx` 而非 `preserve`——
       `preserve` 会让 vitest 的 esbuild 把 JSX 原样留在产物里，
       运行时报 `Unexpected token '<'`（见 ADR 0001 探针法）。 */
    "experimentalDecorators": false,
    "jsx": "react-jsx",

    /* 严格但不阻塞迭代 */
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  // `scripts/**/*.ts` 是开发脚手架（目前只有 dev-cli.ts 一个开发入口）。
  // 纳入类型检查是有意的：它 import 的是 `src/**`，类型错了要在 F5 之前
  // 就被 `pnpm typecheck` 拦住，而不是等启动时才报。
  // 构建产物不含它——`tsconfig.build.json` 的 `include` 只有 `src`。
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
